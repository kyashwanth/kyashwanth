{
  "name": "kyashwanth-site",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio, QA games and prompt library. No build step: these dependencies are for testing only.",
  "scripts": {
    "serve": "http-server . -p 8080 -c-1 -s",
    "test": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.js",
    "test:keyboard": "playwright test tests/keyboard.spec.js",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "http-server": "^14.1.1"
  }
}
